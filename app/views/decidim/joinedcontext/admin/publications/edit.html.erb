<% add_decidim_page_title(t(".title")) %>

<div class="item_show__header">
  <h1 class="item_show__header-title"><%= t(".title") %></h1>
</div>

<div class="item__edit item__edit-1col">
  <div class="item__edit-form">
    <% blocked = targets.empty? || private_space? %>
    <% if targets.empty? %>
      <%= cell("decidim/announcement", t(".no_endpoints"), callout_class: "warning") %>
    <% elsif private_space? %>
      <%= cell("decidim/announcement", t(".private_space"), callout_class: "warning") %>
    <% elsif publication.last_error.present? %>
      <%= cell("decidim/announcement", publication.last_error, callout_class: "alert") %>
    <% elsif publication.active? %>
      <%= cell("decidim/announcement", t(".state_on", target: publication.target.title), callout_class: "success") %>
    <% else %>
      <%= cell("decidim/announcement", t(".state_off"), callout_class: "secondary") %>
    <% end %>

    <% unless blocked %>
    <div class="form__wrapper">
      <div class="card pt-4">
        <div class="card-section row column">
          <h2 class="h4"><%= t(".status") %></h2>
          <div id="joinedcontext-status">
            <p><strong><%= t(".last_synced_at") %>:</strong> <%= publication.last_synced_at ? l(publication.last_synced_at, format: :long) : t(".never") %></p>
            <% if publication.last_error.present? && publication.last_attempt_at %>
              <p><strong><%= t(".last_attempt_at") %>:</strong> <%= l(publication.last_attempt_at, format: :long) %></p>
            <% end %>
            <p><strong><%= t(".last_count") %>:</strong> <%= publication.last_count || "-" %></p>
          </div>
          <%= button_to t(".sync_now"), sync_path, class: "button button__sm button__secondary", disabled: !publication.active?, aria: { describedby: "joinedcontext-sync-help" } %>
          <p id="joinedcontext-sync-help" class="help-text"><%= publication.active? ? t(".sync_help") : t(".sync_disabled_help") %></p>
        </div>
      </div>
    </div>

    <%= decidim_form_for(publication, as: :publication, url: update_path, method: :patch, html: { class: "form form-defaults" }) do |f| %>
      <div class="form__wrapper">
        <div class="card pt-4">
          <div class="card-section">
            <div class="row column">
              <%= f.check_box :enabled, help_text: t(".enabled_help") %>
            </div>
            <div class="row column">
              <%= f.select :endpoint_name, targets.map { |target| [target.title, target.name] }, { prompt: t(".endpoint_prompt"), help_text: t(".endpoint_name_help") } %>
            </div>
            <fieldset class="row column" aria-describedby="joinedcontext-types-help">
              <legend><strong><%= Decidim::Joinedcontext::Publication.human_attribute_name(:component_types) %></strong></legend>
              <p id="joinedcontext-types-help" class="help-text"><%= t(".component_types_help") %></p>
              <%= hidden_field_tag "publication[component_types][]", "", id: nil %>
              <% Decidim::Joinedcontext::Publication::COMPONENT_TYPES.each do |type| %>
                <div>
                  <label>
                    <%= check_box_tag "publication[component_types][]", type, publication.component_types.include?(type), id: "publication_component_types_#{type}" %>
                    <%= t(".component_types.#{type}") %>
                  </label>
                </div>
              <% end %>
              <% if publication.errors[:component_types].any? %>
                <p class="form-error is-visible"><%= publication.errors.full_messages_for(:component_types).to_sentence %></p>
              <% end %>
            </fieldset>
            <p id="joinedcontext-save-help" class="row column help-text"><%= t(".save_help") %></p>
          </div>
        </div>
      </div>
      <div class="item__edit-sticky">
        <div class="item__edit-sticky-container">
          <%= f.submit t(".save"), class: "button button__sm button__secondary", aria: { describedby: "joinedcontext-save-help" } %>
        </div>
      </div>
    <% end %>
    <% end %>
  </div>
</div>
